<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CollisionFlow.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- The API is the composition root: it is the only project allowed to know
       about both the domain and the infrastructure that serves it. -->
  <ItemGroup>
    <ProjectReference Include="..\CollisionFlow.Domain\CollisionFlow.Domain.csproj" />
    <ProjectReference Include="..\CollisionFlow.Infrastructure\CollisionFlow.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The SPA build creates wwwroot, but the API must also run standalone before
       the first "npm run build". Creating it here silences a startup warning
       without committing an empty directory. -->
  <Target Name="EnsureWebRoot" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot')" />
  </Target>

</Project>
