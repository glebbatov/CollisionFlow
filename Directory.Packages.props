<Project>
  <!--
    Central package management: every version in the solution is declared once, here,
    and project files reference packages without a version at all.

    Adopted after a real conflict - Microsoft.Data.SqlClient floors
    Microsoft.Extensions.Logging.Abstractions at 8.0.2, while another project had pinned
    8.0.0, producing NU1605. With versions scattered across four project files that is a
    hunt; with them here it is a diff.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data access">
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <!--
      Microsoft.Data.SqlClient is a standalone library with its own release train, so
      taking the current supported major is correct. That is a different situation from
      the Microsoft.Extensions.* packages below, which ship inside the ASP.NET Core
      shared framework - overriding those with a newer major replaces a runtime
      component, which is why they are held at 8.0.x to match the target framework.
    -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
  </ItemGroup>
  <ItemGroup Label="Framework extensions - held at the target framework's major">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>